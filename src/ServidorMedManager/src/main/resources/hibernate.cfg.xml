<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "https://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- 1. Datos físicos de conexión a tu MySQL -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/medmanager?serverTimezone=UTC</property>
<property name="hibernate.connection.username">medmanager_app</property>
<property name="hibernate.connection.password">PON_AQUI_TU_CLAVE</property>

        <!-- 2. Configuración del comportamiento de Hibernate -->
        <property name="hibernate.show_sql">false</property>
        <property name="hibernate.format_sql">true</property>
        <property name="hibernate.hbm2ddl.auto">validate</property>
        
<!-- 3. Enlazamos las 5 clases Entidad con su nueva ruta .modelo -->
     <mapping class="com.medmanager.ServidorMedManager.modelo.Especialidad"/>
     <mapping class="com.medmanager.ServidorMedManager.modelo.Paciente"/>
     <mapping class="com.medmanager.ServidorMedManager.modelo.Trabajador"/>
     <mapping class="com.medmanager.ServidorMedManager.modelo.Cita"/>
     <mapping class="com.medmanager.ServidorMedManager.modelo.Historial_Medico"/>
    </session-factory> 
</hibernate-configuration>