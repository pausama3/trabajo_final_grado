<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "https://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- 1. Datos físicos de conexión a tu MySQL -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/MedManager?serverTimezone=UTC</property>
        <property name="hibernate.connection.username">root</property>
        <property name="hibernate.connection.password">sangenis</property>

        <!-- 2. Configuración del comportamiento de Hibernate -->
        <property name="hibernate.dialect">org.hibernate.dialect.MySQLDialect</property>
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        <property name="hibernate.hbm2ddl.auto">update</property>
        
        <!-- 3. Enlazamos las 5 clases Entidad con Hibernate (DENTRO de session-factory) -->
        <mapping class="com.medmanager.ServidorMedManager.Especialidad"/>
        <mapping class="com.medmanager.ServidorMedManager.Paciente"/>
        <mapping class="com.medmanager.ServidorMedManager.Trabajador"/>
        <mapping class="com.medmanager.ServidorMedManager.Cita"/>
        <mapping class="com.medmanager.ServidorMedManager.Historial_Medico"/>
    </session-factory> 
</hibernate-configuration>